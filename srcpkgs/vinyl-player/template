# Template file for 'vinyl-player'
pkgname=vinyl-player
version=1.5.0
revision=1
build_style=cargo
hostmakedepends="pkg-config glib-devel"
makedepends="gtk4-devel libadwaita-devel gstreamer1-devel"
short_desc="Simple adwaita music player, developed on relm4 and gst-rs"
maintainer="Nizarjh <chel773@tutamail.com>"
license="GPL-3.0-or-later"
homepage="https://codeberg.org/M23Snezhok/Vinyl"
