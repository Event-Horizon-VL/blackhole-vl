checksum=d980ee98ee838e32dd963d5cd521e8359e474d45ccd1a6a6538f200560f484da

post_install() {
	vinstall ${FILESDIR}/vinyl-player.desktop 644 usr/share/applications
	vinstall data/hicolor/scalable/apps/page.codeberg.M23Snezhok.Vinyl.svg 644 usr/share/pixmaps vinyl.svg
	vbin     "${FILESDIR}/vinyl-player.sh"
}
