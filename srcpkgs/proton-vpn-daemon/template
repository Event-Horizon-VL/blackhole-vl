# Template file for 'proton-vpn-daemon'
pkgname=proton-vpn-daemon
version=0.13.8
revision=1
build_style=python3-pep517
hostmakedepends="python3-build python3-installer python3-setuptools python3-wheel"
depends="python3 python3-dbus-fast python3-psutil python3-packaging python3-proton-vpn-api-core wireguard-tools"
checkdepends="python3-pytest python3-pytest-cov python3-dbus-fast python3-bcc python3-proton-vpn-api-core python3-psutil"
short_desc="Daemons for Proton VPN Linux client (split tunneling service)"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="GPL-3.0-only"
homepage="https://github.com/ProtonVPN/proton-vpn-daemon"
distfiles="https://github.com/ProtonVPN/proton-vpn-daemon/archive/refs/tags/v${version}.tar.gz"
checksum=a8b51794932035797e93db50c64145816fdc4bea951488b5ebdc9c7a4c504ab2
# py3:systemd-python doesn't exist
noverifypydeps=yes

post_install() {
	local pyver
	pyver=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')

	vinstall "${FILESDIR}/dbus.conf" 644 usr/share/dbus-1/system.d me.proton.vpn.split_tunneling.conf

	vinstall "${FILESDIR}/dbus.service" 644 usr/share/dbus-1/services me.proton.vpn.split_tunneling.service
}
