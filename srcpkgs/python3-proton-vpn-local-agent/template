do_install() {
	local pyver
	pyver=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')

	vinstall \
		python-proton-vpn-local-agent/target/${RUST_TARGET}/release/libpython_proton_vpn_local_agent.so \
		755 \
		usr/lib/python${pyver}/site-packages/proton/vpn \
		local_agent.abi3.so
}
