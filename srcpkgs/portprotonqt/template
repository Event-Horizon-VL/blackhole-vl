# Template file for 'portprotonqt'
pkgname=portprotonqt
version=1.4.1
revision=1
build_style=meson
hostmakedepends="ninja pkgconf python-devel gettext Vulkan-Headers"
makedepends="vulkan-loader-devel SDL3-devel python3-packaging-bootstrap"
depends="python3-pyside6 python3-Babel python3-psutil python3-requests python3-vdf python3-Pillow python3-BeautifulSoup4 python3-orjson python3-evdev python3-pyudev python3-tqdm python3-libarchive-c python3-rapidfuzz python3-pyside6-widgets python3-dbus-fast python3-pyside6-svg python3-websocket-client python3-pyside6-network python3-pefile qt6-svg vulkan-loader SDL3"
short_desc="Modern interface for managing games from PortProton and Steam"
maintainer="LINUXHUNTERREDHAT <soyu7658@gmail.com>"
license="MIT"
homepage=https://git.linux-gaming.ru/Linux-Gaming/PortProtonQt
distfiles="http://git.linux-gaming.ru/Linux-Gaming/PortProtonQt/archive/v${version}.tar.gz"
checksum=31c25790d13e728b28ae1de26788a6563d00e696d6c67c04699f8ce4f4aa8a1d
post_install() {
	bash "${wrksrc}/dev-scripts/generate-completions.sh"
	vinstall "${wrksrc}/completions/portprotonqt" 644 usr/share/bash-completion/completions
	vinstall "${wrksrc}/completions/portprotonqt.fish" 644 usr/share/fish/vendor_completions.d
	vinstall "${wrksrc}/completions/_portprotonqt" 644 usr/share/zsh/site-functions
	vlicense LICENSE
	vdoc "${FILESDIR}/README.voidlinux"
}
