post_install() {
	bash "${wrksrc}/dev-scripts/generate-completions.sh"
	vcompletion "${wrksrc}/completions/portprotonqt" bash
	vcompletion "${wrksrc}/completions/portprotonqt.fish" fish
	vcompletion "${wrksrc}/completions/_portprotonqt" zsh
	vdoc "${FILESDIR}/README.voidlinux"
}
